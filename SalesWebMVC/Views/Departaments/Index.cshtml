@model IEnumerable<SalesWebMVC.Models.Departament>

@{
    ViewData["Title"] = "Departamentos";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

    <div>

        <h2 class="mb-1">
            <i class="bi bi-building text-info me-2"></i>
            @ViewData["Title"]
        </h2>

        <p class="text-secondary mb-0">
            Gerencie os departamentos cadastrados no sistema.
        </p>

    </div>

    <a asp-action="Create" class="btn btn-primary shadow-sm">

        <i class="bi bi-plus-circle me-2"></i>

        Novo Departamento

    </a>

</div>

<div class="card shadow-sm border-0">

    <div class="card-header d-flex justify-content-between align-items-center">

        <span class="fw-semibold border-1">

            Lista de Departamentos

        </span>

        <span class="badge bg-info text-dark">

            @Model.Count() registro(s)

        </span>

    </div>

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info text-center mb-0">

                <i class="bi bi-info-circle me-2"></i>

                Nenhum departamento cadastrado.

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th>
                                @Html.DisplayNameFor(model => model.Name)
                            </th>

                            <th class="text-center" style="width:170px;">
                                Ações
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">

                                    <i class="bi bi-building text-info me-2"></i>

                                    @item.Name

                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning me-1"
                                       title="Editar">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-info me-1"
                                       title="Detalhes">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger"
                                       title="Excluir">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>