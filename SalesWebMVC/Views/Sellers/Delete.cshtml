@model SalesWebMVC.Models.Seller

@{
    ViewData["Title"] = "Excluir Vendedor";
}

<div class="mb-4">

    <h2 class="mb-1 text-danger">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @ViewData["Title"]

    </h2>

    <p class="text-secondary mb-0">

        Confirme os dados abaixo antes de excluir o vendedor.

    </p>

</div>

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card border-danger shadow-sm">

            <div class="card-header bg-danger text-white">

                <strong>

                    <i class="bi bi-trash me-2"></i>

                    Confirmação de Exclusão

                </strong>

            </div>

            <div class="card-body">

                <div class="alert alert-warning">

                    <i class="bi bi-exclamation-circle me-2"></i>

                    Esta ação é permanente e não poderá ser desfeita.

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="fw-bold text-secondary">
                            Nome
                        </label>

                        <div>
                            @Model.Name
                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="fw-bold text-secondary">
                            Email
                        </label>

                        <div>
                            @Model.Email
                        </div>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="fw-bold text-secondary">
                            Data de Nascimento
                        </label>

                        <div>
                            @Model.BirthDate.ToString("dd/MM/yyyy")
                        </div>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="fw-bold text-secondary">
                            Salário Base
                        </label>

                        <div>
                            @Model.BaseSalary.ToString("C")
                        </div>

                    </div>

                </div>

                <hr />

                <form asp-action="Delete">

                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-2"></i>

                            Cancelar

                        </a>

                        <button type="submit"
                                class="btn btn-danger">

                            <i class="bi bi-trash me-2"></i>

                            Excluir

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>