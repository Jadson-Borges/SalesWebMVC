@model SalesWebMVC.Models.Seller

@{
    ViewData["Title"] = "Detalhes";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>
        Detalhes do Vendedor(a)!
    </h4>

    <div>
        <h4>Seller</h4>
        <hr />
        <dl class="dl-horizontal">

            <dt>
                Nome
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Name)
            </dd>

            <dt>
                Email
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Email)
            </dd>
            <dt>
                Data de Nascimento
            </dt>

            <dd>
                @Html.DisplayFor(model => model.BirthDate)
            </dd>

            <dt>
                Salário base
            </dt>

            <dd>
                @Html.DisplayFor(model => model.BaseSalary)
            </dd>
            <dt>
                Departamento
            </dt>

            <dd>
                @Html.DisplayFor(model => model.Departament.Name)
            </dd>

        </dl>
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />        
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index">Voltar a Lista</a>
    </form>
</div>