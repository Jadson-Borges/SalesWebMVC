@model SalesWebMVC.Models.ViewModels.SellerFormViewModel

@{
    ViewData["Title"] = "Cadastro de Vendedor(a)";
}

<h2>@ViewData["Title"]</h2>

<h4>Vendedor(a)</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            <div class="form-group">
                <label class="control-label">Nome</label>
                <input asp-for="Seller.Name" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Email</label>
                <input asp-for="Seller.Email" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Data de Nascimento</label>
                <input asp-for="Seller.BirthDate" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Salário Base</label>
                <input asp-for="Seller.BaseSalary" class="form-control" />
            </div>

            <div class="form-group">
                <label "class="control-label">Departamento</label>
                <select asp-for="Seller.DepartamentId" asp-items="@(new SelectList(Model.Departaments, "Id", "Name"))" class="form-control">
                </select>
            </div>
            <div class="form-group mt-3">

                <input type="submit" value="Cadastrar" class="btn btn-primary" />
            </div>
        </form>
    </div>

</div>